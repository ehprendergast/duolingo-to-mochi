# OCR Provider: "tesseract" (default, free) or "cloud" (uses Netlify function)
VITE_OCR_PROVIDER=tesseract

# Cloud OCR via Netlify Functions (optional)
# Set these in Netlify dashboard -> Env vars, NOT in this file
# GOOGLE_VISION_API_KEY=your_key_here  (for google vision)
# OPENAI_API_KEY=sk-...                (for openai vision + furigana fallback)
# ANTHROPIC_API_KEY=sk-ant-...         (preferred for furigana - you asked)
# OCR_PROVIDER=google  # google | openai | anthropic
# OPENAI_VISION_MODEL=gpt-4o-mini
# ANTHROPIC_FURIGANA_MODEL=claude-3-haiku-20240307  # cheap & fast, best for furigana

# Furigana / Pinyin generation (new)
# Uses ANTHROPIC_API_KEY if set, else OPENAI_API_KEY, else tries kuromoji local
# Set in Netlify UI with scopes: Builds, Functions, Runtime
# ANTHROPIC_API_KEY=sk-ant-...

# Local dev:
# VITE_OCR_PROVIDER=cloud  (to use cloud OCR function)
# netlify dev
