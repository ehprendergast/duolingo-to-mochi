# OCR Provider: "tesseract" (default, free, client-side) or "cloud" (uses Netlify function)
VITE_OCR_PROVIDER=tesseract

# Cloud OCR via Netlify Functions (optional, for better accuracy)
# Set these in Netlify dashboard, NOT in this file (keeps keys secret)
# GOOGLE_VISION_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# OCR_PROVIDER=google  # or "openai"
# OPENAI_VISION_MODEL=gpt-4o-mini

# For local dev of cloud OCR, you can set:
# VITE_OCR_PROVIDER=cloud
# Then set API keys in .env (not committed) for netlify dev
